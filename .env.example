# =============================================================================
# FlowViz Configuration
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Add at least one AI provider API key below
# 3. Start the server: npm run dev:full

# =============================================================================
# AI PROVIDER (REQUIRED) - Choose one or multiple
# =============================================================================

DEFAULT_AI_PROVIDER = ollama

# OPENROUTER - Recommended: one key, access to Claude/GPT/Gemini and more
# Get your API key from: https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-sonnet-5

# ANTHROPIC (Claude) - direct API access
# Get your API key from: https://console.anthropic.com/account/keys
# ANTHROPIC_API_KEY=

# OPENAI (GPT) - direct API access
# Get your API key from: https://platform.openai.com/account/api-keys
# OPENAI_API_KEY=

# OLLAMA - ensure that the local ollama instance is already up and running on your machine
# Default local Ollama endpoint - change to other IP depending on your setup
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Model for text analysis
OLLAMA_TEXT_MODEL=huggingface.co/TeichAI/Qwen3-14B-Claude-Sonnet-4.5-Reasoning-Distill-GGUF:latest
# Use this model if you increased the context size of the default model - refer to `Ollama Configuration` in the README
# OLLAMA_TEXT_MODEL=Qwen3-14B-Claude-Sonnet-4.5-Reasoning-Distill-GGUF-32768-context:latest
# Placeholder - vision analysis currently not supported for Ollama
OLLAMA_VISION_MODEL=qwen3-vl

# =============================================================================
# OPTIONAL SETTINGS (uncomment to override defaults)
# =============================================================================

# Specific model to use (defaults: anthropic/claude-sonnet-5, claude-sonnet-4-5-20250929, gpt-4o, huggingface.co/TeichAI/Qwen3-14B-Claude-Sonnet-4.5-Reasoning-Distill-GGUF:latest)
# OPENROUTER_MODEL=anthropic/claude-sonnet-5
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# OPENAI_MODEL=gpt-4o

# Override the OpenRouter/OpenAI/Anthropic API base URL (rarely needed)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Server port (default: 3001)
# PORT=3001

# =============================================================================
# SECURITY NOTES
# =============================================================================
# • Never commit .env to version control
# • Keep API keys secure and rotate regularly
# • All API calls happen server-side for security
